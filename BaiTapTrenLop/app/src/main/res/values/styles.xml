<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FormField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/field_bg</item>
        <item name="boxStrokeColor">@color/neon_green</item>
        <item name="boxStrokeErrorColor">@color/neon_red</item>
        <item name="errorTextColor">@color/neon_red</item>
        <item name="hintTextColor">@color/neon_green</item>
        <item name="errorEnabled">true</item>
    </style>

    <style name="DetailLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9FB3D9</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>